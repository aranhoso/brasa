# Copie este arquivo para ".env" e preencha. O .env tem segredos: nunca faça commit dele.

# --- Endereço público do servidor (usado nos links de convite) ---
# O mesmo endereço que você usa em VITE_SERVER_URL no app (sem barra no fim).
PUBLIC_URL=http://localhost:8000

# --- Cloudflare Realtime SFU (OBRIGATÓRIO para voz e compartilhamento de tela) ---
# dash.cloudflare.com → Realtime → Serverless SFU → Create (App ID + App Secret)
CF_REALTIME_APP_ID=
CF_REALTIME_APP_TOKEN=

# --- Cloudflare TURN (opcional; ajuda quem está em rede que bloqueia UDP) ---
# dash.cloudflare.com → Realtime → TURN Server → Create
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=

# --- E-mails (opcional; confirmação de cadastro e "esqueci a senha") ---
# Sem estas duas, o cadastro entra direto, sem confirmar o e-mail.
# resend.com → Domains (verifique um domínio seu) → API Keys → chave "Sending access" só desse domínio
# RESEND_API_KEY=
# EMAIL_FROM=Brasa <nao-responda@mail.seu-dominio.com>

# --- Releases (opcional; página /download e versão web no navegador) ---
# O repositório público onde o CI publica os instaladores (ver o README)
# WEB_RELEASES_REPO=seu-usuario/brasa-releases

# --- Outros (opcionais) ---
# JWT_SECRET=          # se vazio, um segredo aleatório é gerado em .jwt_secret
# MAX_UPLOAD_MB=10
# VOICE_RECONNECT_GRACE_SECONDS=20
# NGROK_DOMAIN=        # domínio fixo do ngrok, para "py run.py --ngrok"
